# Copy to .env and fill in only what you have. The app runs fully with NONE set.

# --- Provider selection: auto | free | <provider name> ---
SCRIPT_PROVIDER=auto      # auto -> openai if key present, else free templates
TTS_PROVIDER=auto         # auto -> openai if key, else gtts (free online), else silent
VISUALS_PROVIDER=auto     # auto -> pexels if key present, else offline gradient
VIDEOGEN_PROVIDER=auto    # auto -> fal/runway if key present, else Ken Burns (free)

# --- FREE TIER needs NO keys. Add keys below to unlock the PREMIUM tier. ---

# Smarter scripts + natural TTS voices
OPENAI_API_KEY=

# Real stock footage backgrounds (FREE key at pexels.com/api — recommended)
PEXELS_API_KEY=

# --- Premium image-to-video (animate product photos into real AI clips) ---
# fal.ai: one key reaches Kling / Runway / Veo / etc. (recommended)
FAL_API_KEY=
FAL_VIDEO_MODEL=fal-ai/kling-video/v2/master/image-to-video
# Runway native API (alternative to fal)
RUNWAY_API_KEY=
RUNWAY_VIDEO_MODEL=gen4_turbo

KLING_API_KEY=
ELEVENLABS_API_KEY=

# --- Rendering (9:16 vertical short) ---
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

CORS_ORIGINS=http://localhost:3000
